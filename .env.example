# ── SMTP (Gmail App Password OR any provider / Amazon SES SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Display identity
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=CryptoByt
MAIL_REPLY_TO=
SMTP_ENVELOPE_FROM=
SMTP_HELO=
SMTP_UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

# Throughput (LeadBot-style)
# 0 = max speed | 150 = default safe | 2000 = warm-up
SMTP_SEND_DELAY_MS=150
SMTP_MAX_CONNECTIONS=2

# Amazon SES example (uncomment + fill):
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIA...
# SMTP_PASS=...
# MAIL_FROM=noreply@your-verified-domain.com
# MAIL_FROM_NAME=CryptoByt
# SMTP_MAX_CONNECTIONS=5
# SMTP_SEND_DELAY_MS=50

# Neon Postgres — inbox, leads, stats, opens
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# REQUIRED for open/click tracking — live public HTTPS URL (no trailing slash)
APP_URL=https://your-app.vercel.app

# SEC EDGAR (required for extract)
SEC_USER_AGENT=CryptoByt (you@yourdomain.com)

# Optional paid verification
ZEROBOUNCE_API_KEY=
HUNTER_API_KEY=
