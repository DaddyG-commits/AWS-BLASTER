# Gmail SMTP (Google App Password)
# 1. Enable 2-Step Verification on the Google account
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password (spaces optional — stripped automatically)

SMTP_USER=lawofficeclientdesk@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# From address must be the same Gmail (or a Send mail as alias on that account)
MAIL_FROM=lawofficeclientdesk@gmail.com
MAIL_FROM_NAME=CryptoByt

# Neon Postgres — required for Sent Inbox, stats, and failure logs
# Create free project at https://console.neon.tech then run schema.sql
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Optional overrides
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
