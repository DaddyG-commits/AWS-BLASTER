# ── SMTP (Gmail App Password OR Amazon SES SMTP) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=CryptoByt
MAIL_REPLY_TO=
SMTP_ENVELOPE_FROM=
SMTP_HELO=
SMTP_UNSUBSCRIBE_URL=https://yourdomain.com/unsubscribe

SMTP_SEND_DELAY_MS=150
SMTP_MAX_CONNECTIONS=2

# Amazon SES example:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIA...
# SMTP_PASS=...
# MAIL_FROM=noreply@your-verified-domain.com
# SMTP_MAX_CONNECTIONS=5
# SMTP_SEND_DELAY_MS=50

DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

APP_URL=https://your-app.vercel.app

ZEROBOUNCE_API_KEY=
