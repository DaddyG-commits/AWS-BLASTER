# Zoho Mail SMTP Configuration
# Get these from your Zoho Mail account
# For personal/free: smtp.zoho.com
# For organization/paid custom domain: smtppro.zoho.com
# Regional: smtp.zoho.eu, smtp.zoho.in, etc.

SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-app-specific-password

# Optional: Default from address (must match authenticated user or alias)
SMTP_FROM=your-email@yourdomain.com